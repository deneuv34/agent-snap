{
  "name": "@agent-snap/core",
  "version": "0.1.0",
  "description": "Type-safe TypeScript client for the agent-snap Go core (JSONL over stdin/stdout)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.json",
    "prepack": "bun run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-snap",
    "snapshot",
    "git",
    "working-tree"
  ]
}
